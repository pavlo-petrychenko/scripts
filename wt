#!/usr/bin/env bash
# wt - create worktree via `make worktree` + a window with the 3-pane layout
# Usage: wt <name> [-p <prompt>] [flags...]
#   -p <prompt>   Start the agent in plan mode with the given prompt
#   Flags are forwarded to `make worktree` (e.g. --no-install, --symlink, --verbose)
#
# Layout:
# ┌──────────┬──────────┐
# │  agent   │   root   │
# ├──────────┴──────────┤
# │        logs         │
# └─────────────────────┘
#
# Runs under tmux and cmux (see wt-mux.sh). Under cmux the window is a cmux
# workspace. The agent pane runs the `claude` CLI on both backends; set
# WT_NO_AGENT=1 to leave it as a bare shell.

set -euo pipefail

. "${WT_LIB:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/wt-mux.sh}"

if [ $# -lt 1 ] || [[ "$1" == --* ]]; then
  echo "Usage: wt <name> [-p <prompt>] [--no-install] [--no-init] [--verbose] [--full-install] [--symlink]"
  exit 1
fi

name="$1"
shift

# Parse -p <prompt> if provided
prompt=""
flags=""
while [ $# -gt 0 ]; do
  case "$1" in
    -p)
      shift
      prompt="$1"
      shift
      ;;
    *)
      flags="$flags $1"
      shift
      ;;
  esac
done
flags="${flags# }"

# Must be inside a git repo
repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "Error: not inside a git repo"
  exit 1
}

worktree_dir="$repo_root/../website-$name"

# Create worktree if it doesn't exist
if [ ! -d "$worktree_dir" ]; then
  make -C "$repo_root" worktree branch="$name" folder="$name" flags="$flags"
else
  echo "Worktree already exists: $worktree_dir"
fi

# Resolve to absolute path
worktree_dir=$(cd "$worktree_dir" && pwd)

# Husky v9 needs .husky/_/ dir per worktree; copy-on-write skips `prepare` script
if [ -d "$worktree_dir/.husky" ] && [ ! -d "$worktree_dir/.husky/_" ]; then
  (cd "$worktree_dir" && npx husky 2>/dev/null) || true
fi

# Reuse the window if one already exists for this worktree. Duplicate names would
# make every later name lookup ambiguous, so never create a second one.
if mux_has_window "$name"; then
  echo "Window already exists: $name"
  mux_select_window "$name"
  # The agent pane already has a session in it. Typing a fresh `claude` command
  # into it would land in that session's prompt box rather than a shell.
  if [ -n "$prompt" ]; then
    echo "Note: -p ignored, the agent pane is already running. Send the prompt there directly."
  fi
else
  mux_new_window "$name" "$worktree_dir"
  if [ -n "$prompt" ]; then
    mux_agent_prompt "$name" "$prompt"
  else
    mux_agent_start "$name"
  fi
fi

# Only blocks when there was no multiplexer to create the window in.
mux_attach "$name"
